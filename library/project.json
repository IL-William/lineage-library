{
  "adapter": "snowflake",
  "sources": {
    "raw.books": {
      "relation": "LAB.RAW.BOOKS",
      "columns": ["book_id", "title", "author_first", "author_last", "isbn", "published_on", "genre_code", "tags"]
    },
    "raw.members": {
      "relation": "LAB.RAW.MEMBERS",
      "columns": ["member_id", "given_name", "family_name", "email", "joined_at", "branch_code", "deleted"]
    },
    "raw.loans": {
      "relation": "LAB.RAW.LOANS",
      "columns": ["loan_id", "book_id", "member_id", "branch_code", "borrowed_at", "due_on", "returned_at", "status"]
    },
    "raw.fines": {
      "relation": "LAB.RAW.FINES",
      "columns": ["fine_id", "loan_id", "amount_cents", "assessed_at", "waived"]
    },
    "raw.reviews": {
      "relation": "LAB.RAW.REVIEWS",
      "columns": ["review_id", "book_id", "member_id", "stars", "written_at"]
    },
    "raw.loans_archive": {
      "relation": "LAB.RAW.LOANS_ARCHIVE",
      "columns": ["loan_id", "book_id", "member_id", "branch_code", "borrowed_at", "returned_at", "due_on", "status", "archived_at"]
    },
    "raw.interlibrary_loans": {
      "relation": "LAB.RAW.INTERLIBRARY_LOANS",
      "columns": ["request_id", "title_id", "patron_id", "requested_at", "due_back_on", "received_back_at", "request_status", "lender"]
    }
  },
  "models": {
    "books": {
      "relation": "LAB.SHELF.BOOKS",
      "materialized": "view",
      "parents": ["raw.books"],
      "columns": ["book_id", "title", "author", "published_on", "genre_code", "isbn13", "tags", "shelf_version", "shelved_at"]
    },
    "members": {
      "relation": "LAB.SHELF.MEMBERS",
      "materialized": "table",
      "parents": ["raw.members"],
      "columns": ["member_id", "email", "joined_at", "branch_code", "display_name", "email_key"]
    },
    "loans_enriched": {
      "relation": "LAB.SHELF.LOANS_ENRICHED",
      "materialized": "table",
      "parents": ["raw.loans", "members"],
      "columns": ["loan_id", "book_id", "member_id", "borrower", "branch_code", "borrowed_at", "loan_state", "days_out"]
    },
    "book_tags": {
      "relation": "LAB.SHELF.BOOK_TAGS",
      "materialized": "table",
      "parents": ["books"],
      "columns": ["book_id", "tag", "tag_position"]
    },
    "fines_clean": {
      "relation": "LAB.SHELF.FINES_CLEAN",
      "materialized": "view",
      "parents": ["raw.fines"],
      "columns": ["fine_id", "loan_id", "amount", "amount_due", "fine_fingerprint", "assessed_on"]
    },
    "member_fines": {
      "relation": null,
      "materialized": "ephemeral",
      "parents": ["fines_clean", "loans_enriched"],
      "columns": ["member_id", "fine_count", "total_due", "last_assessed_on"]
    },
    "member_summary": {
      "relation": "LAB.SHELF.MEMBER_SUMMARY",
      "materialized": "table",
      "parents": ["members", "member_fines"],
      "columns": ["member_id", "email", "joined_at", "branch_code", "display_name", "email_key", "fine_count", "total_due", "last_assessed_on", "member_checksum"]
    },
    "loan_ranks": {
      "relation": "LAB.SHELF.LOAN_RANKS",
      "materialized": "table",
      "parents": ["loans_enriched", "books"],
      "columns": ["loan_id", "member_id", "genre_code", "recency_in_genre", "age_rank_for_member"]
    },
    "reading_lists": {
      "relation": "LAB.SHELF.READING_LISTS",
      "materialized": "table",
      "parents": ["raw.reviews", "books"],
      "columns": ["member_id", "titles_in_order", "mean_stars"]
    },
    "branch_activity": {
      "relation": "LAB.SHELF.BRANCH_ACTIVITY",
      "materialized": "table",
      "parents": ["loans_enriched", "members"],
      "columns": ["branch_code", "branch_name", "activity", "happened_at"]
    },
    "loan_history": {
      "relation": "LAB.SHELF.LOAN_HISTORY",
      "materialized": "incremental",
      "parents": ["loans_enriched"],
      "columns": ["loan_id", "member_id", "loan_state", "days_out", "borrowed_at"]
    },
    "twin_scopes": {
      "relation": "LAB.SHELF.TWIN_SCOPES",
      "materialized": "view",
      "parents": ["books", "raw.reviews"],
      "columns": ["book_id", "title", "best_stars"]
    },
    "book_labels": {
      "relation": "LAB.SHELF.BOOK_LABELS",
      "materialized": "view",
      "parents": ["books"],
      "columns": ["book_id", "title", "author", "published_on", "genre_code", "isbn13", "tags", "shelf_version", "shelved_at"]
    },
    "loan_keys": {
      "relation": "LAB.SHELF.LOAN_KEYS",
      "materialized": "view",
      "parents": ["loans_enriched"],
      "columns": ["loan_id", "book_id", "member_id"]
    },
    "member_branch_loans": {
      "relation": "LAB.SHELF.MEMBER_BRANCH_LOANS",
      "materialized": "table",
      "parents": ["loans_enriched"],
      "columns": ["member_id", "north_loans", "south_loans", "east_loans"]
    },
    "catalogue_entries": {
      "relation": "LAB.SHELF.CATALOGUE_ENTRIES",
      "materialized": "view",
      "parents": ["books"],
      "columns": ["book_id", "title", "bare_title", "title_key"]
    },
    "all_loans": {
      "relation": "LAB.SHELF.ALL_LOANS",
      "materialized": "table",
      "parents": ["raw.loans", "raw.loans_archive", "raw.interlibrary_loans"],
      "columns": ["loan_id", "book_id", "member_id", "branch_code", "borrowed_at", "due_on", "returned_at", "status"]
    },
    "loans_unioned": {
      "relation": null,
      "materialized": "ephemeral",
      "parents": ["raw.loans", "raw.loans_archive"],
      "columns": ["_dbt_source_relation", "loan_id", "book_id", "member_id", "branch_code", "borrowed_at", "due_on", "returned_at", "status", "archived_at"]
    },
    "loan_ledger": {
      "relation": "LAB.SHELF.LOAN_LEDGER",
      "materialized": "table",
      "parents": ["loans_unioned"],
      "columns": ["_dbt_source_relation", "loan_id", "book_id", "member_id", "branch_code", "borrowed_at", "due_on", "returned_at", "status", "archived_at"]
    },
    "book_ratings": {
      "relation": "LAB.SHELF.BOOK_RATINGS",
      "materialized": "view",
      "parents": ["books", "raw.reviews"],
      "columns": ["book_id", "title", "best_stars", "last_review_at"]
    },
    "loan_titles": {
      "relation": "LAB.SHELF.LOAN_TITLES",
      "materialized": "table",
      "parents": ["loans_enriched", "books"],
      "columns": ["loan_id", "borrowed_at", "title", "genre"]
    },
    "shelf_tags": {
      "relation": "LAB.SHELF.SHELF_TAGS",
      "materialized": "table",
      "parents": ["books"],
      "columns": ["book_id", "tag"]
    },
    "tag_rows": {
      "relation": "LAB.SHELF.TAG_ROWS",
      "materialized": "table",
      "parents": ["books"],
      "columns": ["book_id", "tag", "tag_position"]
    },
    "review_documents": {
      "relation": "LAB.SHELF.REVIEW_DOCUMENTS",
      "materialized": "view",
      "parents": ["raw.reviews"],
      "columns": ["review_id", "review_doc", "review_hash"]
    },
    "tag_spellings": {
      "relation": "LAB.SHELF.TAG_SPELLINGS",
      "materialized": "view",
      "parents": ["books"],
      "columns": ["book_id", "tag_titles", "tags_beyond_genre"]
    }
  }
}
